ARG UPSTREAM_IMAGE=uav-sf-family-a-thor:upstream-required
FROM ${UPSTREAM_IMAGE}

ARG BUILD_JOBS=12
ARG REPOSITORY_COMMIT
ARG OBSERVER_PROFILE=baseline

SHELL ["/bin/bash", "-o", "pipefail", "-c"]
WORKDIR /opt/uav_sf
RUN if [[ -f /opt/family_a_observer_profile ]]; then \
      test "$(cat /opt/family_a_observer_profile)" = "${OBSERVER_PROFILE}"; \
    else \
      test "${OBSERVER_PROFILE}" = baseline \
      && printf '%s\n' baseline > /opt/family_a_observer_profile; \
    fi

# Only use a previously attested full Family A image. The immutable apt,
# Python, source, patch, PX4, Agent, and upstream ROS layers are retained;
# current project code and its ROS packages are rebuilt below.
# COPY merges into the existing tree, so a file the repository has deleted
# would survive from the upstream image and the result would no longer match
# the revision it is labelled with.  Remove the directories the build context
# replaces in full, and keep detached sources and build outputs such as
# external/ that the context deliberately excludes.
RUN rm -rf /opt/uav_sf/.github \
    /opt/uav_sf/config /opt/uav_sf/containers /opt/uav_sf/data \
    /opt/uav_sf/docs /opt/uav_sf/patches /opt/uav_sf/runtime \
    /opt/uav_sf/scripts /opt/uav_sf/tests
COPY . /opt/uav_sf
RUN test -n "${REPOSITORY_COMMIT}" \
    && printf '%s\n' "${REPOSITORY_COMMIT}" > /opt/family_a_repository_revision \
    && rm -f /opt/family_a_candidate_manifest.json \
    && ./scripts/validation/validate_repo.sh \
    && ./scripts/setup/build_candidates.sh --jobs "${BUILD_JOBS}" \
       --prefix /opt --phase project-workspace

LABEL org.opencontainers.image.revision="${REPOSITORY_COMMIT}"
LABEL org.opencontainers.image.observer-profile="${OBSERVER_PROFILE}"

ENTRYPOINT ["/opt/uav_sf/containers/family_a_runtime/entrypoint.sh"]
CMD ["python3", "-m", "scripts.runtime.preflight", "--self-check"]
