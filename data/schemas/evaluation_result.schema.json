{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jacksonw1025.github.io/uav_sf/evaluation_result.schema.json",
  "title": "Family A evaluation result",
  "type": "object",
  "required": ["schema_version", "plan_id", "run_id", "status", "evidence_gate", "oracles"],
  "properties": {
    "schema_version": {"enum": ["1.0", "1.1"]},
    "plan_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["PASS", "VIOLATION", "INCONCLUSIVE"]},
    "evidence_gate": {
      "type": "object",
      "required": ["status", "checks", "reasons"],
      "properties": {
        "status": {"enum": ["ADMISSIBLE", "INADMISSIBLE"]},
        "checks": {"type": "object"},
        "reasons": {"type": "array", "items": {"type": "string"}}
      }
    },
    "oracles": {
      "type": "array",
      "minItems": 3,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["oracle", "clauses"],
        "properties": {
          "oracle": {"type": "string"},
          "clauses": {"type": "object"}
        }
      }
    },
    "semantic_disposition": {
      "type": "object",
      "required": ["primary", "all"],
      "properties": {
        "primary": {"$ref": "#/$defs/semanticDisposition"},
        "all": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/semanticDisposition"}
        }
      },
      "additionalProperties": false
    },
    "findings": {
      "type": "array",
      "items": {"$ref": "#/$defs/finding"}
    },
    "evidence": {
      "type": "object",
      "required": ["admissibility", "oracle_count", "clause_count", "gate_reason_count"],
      "properties": {
        "admissibility": {"enum": ["ADMISSIBLE", "INADMISSIBLE"]},
        "oracle_count": {"type": "integer", "minimum": 0},
        "clause_count": {"type": "integer", "minimum": 0},
        "gate_reason_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "semanticDisposition": {
      "enum": [
        "SPEC_VIOLATION",
        "SAFETY_CONTRACT_VIOLATION",
        "DIFFERENTIAL_DIVERGENCE",
        "PASS",
        "UNKNOWN",
        "NOT_APPLICABLE"
      ]
    },
    "finding": {
      "type": "object",
      "required": [
        "finding_id",
        "oracle",
        "clause",
        "clause_status",
        "semantic_disposition",
        "contract_provenance",
        "classifications",
        "reasons",
        "evidence"
      ],
      "properties": {
        "finding_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "oracle": {"type": "string", "minLength": 1},
        "clause": {"type": "string", "minLength": 1},
        "clause_status": {"enum": ["PASS", "VIOLATION", "UNKNOWN", "NOT_APPLICABLE"]},
        "semantic_disposition": {"$ref": "#/$defs/semanticDisposition"},
        "contract_provenance": {
          "type": "object",
          "required": ["kind", "source", "public_spec_reference", "threshold_field"],
          "properties": {
            "kind": {"enum": ["PUBLIC_SPEC", "RESEARCH_SAFETY_CONTRACT", "DIFFERENTIAL_ONLY"]},
            "source": {"type": "string", "minLength": 1},
            "public_spec_reference": {"type": ["string", "null"]},
            "threshold_field": {"type": ["string", "null"]}
          },
          "additionalProperties": false
        },
        "classifications": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "PUBLIC_SPEC_GROUNDED",
              "RESEARCH_SAFETY_CONTRACT",
              "SAFETY_RELEVANT_EXPOSURE",
              "SOFTWARE_OR_DIAGNOSTIC_ANOMALY",
              "THRESHOLD_SENSITIVE_ANOMALY",
              "POSSIBLE_EXPERIMENT_OR_ORACLE_ARTIFACT"
            ]
          }
        },
        "reasons": {"type": "array", "items": {"type": "string"}},
        "evidence": {"type": "object"}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"const": "1.1"}}},
      "then": {"required": ["semantic_disposition", "findings", "evidence"]}
    },
    {
      "if": {"properties": {"schema_version": {"const": "1.0"}}},
      "then": {
        "not": {
          "anyOf": [
            {"required": ["semantic_disposition"]},
            {"required": ["findings"]},
            {"required": ["evidence"]}
          ]
        }
      }
    }
  ],
  "additionalProperties": false
}
