{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jacksonw1025.github.io/uav_sf/matched_block.schema.json",
  "title": "Strict matched differential block",
  "type": "object",
  "required": [
    "schema_version",
    "block_id",
    "profile",
    "declared_match",
    "arms"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "block_id": {"$ref": "#/$defs/digest"},
    "profile": {
      "enum": [
        "ROUTE_HANDOFF",
        "PROCESS_LOSS_FALLBACK",
        "SETPOINT_STALL_HEALTHY"
      ]
    },
    "declared_match": {"$ref": "#/$defs/declaredMatch"},
    "arms": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/arm"}
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "compatibleStatus": {"enum": ["PASS", "VIOLATION", "INCONCLUSIVE"]},
    "semanticDisposition": {
      "enum": [
        "SPEC_VIOLATION",
        "SAFETY_CONTRACT_VIOLATION",
        "DIFFERENTIAL_DIVERGENCE",
        "PASS",
        "UNKNOWN",
        "NOT_APPLICABLE"
      ]
    },
    "declaredMatch": {
      "type": "object",
      "required": [
        "abstract_task",
        "setpoint_level",
        "fault_semantics",
        "successor_semantics",
        "fallback_semantics",
        "simulation_seed",
        "fault_seed",
        "schedule_seed",
        "planned_action_offset_ns",
        "cpu_set",
        "load_profile",
        "observer_config_digest",
        "environment_digest",
        "common_software_digest"
      ],
      "properties": {
        "abstract_task": {"type": "string", "minLength": 1},
        "setpoint_level": {"enum": ["trajectory", "attitude", "body_rate"]},
        "fault_semantics": {"type": "string", "minLength": 1},
        "successor_semantics": {"type": "string", "minLength": 1},
        "fallback_semantics": {"type": "string", "minLength": 1},
        "simulation_seed": {"type": "integer", "minimum": 0},
        "fault_seed": {"type": "integer", "minimum": 0},
        "schedule_seed": {"type": "integer", "minimum": 0},
        "planned_action_offset_ns": {"type": "integer", "minimum": 0},
        "cpu_set": {"type": "string", "minLength": 1},
        "load_profile": {"type": "string", "minLength": 1},
        "observer_config_digest": {"$ref": "#/$defs/digest"},
        "environment_digest": {"$ref": "#/$defs/digest"},
        "common_software_digest": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false
    },
    "realizedMatch": {
      "type": "object",
      "required": [
        "abstract_task",
        "setpoint_level",
        "fault_semantics",
        "successor_semantics",
        "fallback_semantics",
        "simulation_seed",
        "fault_seed",
        "schedule_seed",
        "actual_action_offset_ns",
        "cpu_set",
        "load_profile",
        "observer_config_digest",
        "environment_digest",
        "common_software_digest"
      ],
      "properties": {
        "abstract_task": {"type": "string", "minLength": 1},
        "setpoint_level": {"enum": ["trajectory", "attitude", "body_rate"]},
        "fault_semantics": {"type": "string", "minLength": 1},
        "successor_semantics": {"type": "string", "minLength": 1},
        "fallback_semantics": {"type": "string", "minLength": 1},
        "simulation_seed": {"type": "integer", "minimum": 0},
        "fault_seed": {"type": "integer", "minimum": 0},
        "schedule_seed": {"type": "integer", "minimum": 0},
        "actual_action_offset_ns": {"type": "integer", "minimum": 0},
        "cpu_set": {"type": "string", "minLength": 1},
        "load_profile": {"type": "string", "minLength": 1},
        "observer_config_digest": {"$ref": "#/$defs/digest"},
        "environment_digest": {"$ref": "#/$defs/digest"},
        "common_software_digest": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false
    },
    "treatment": {
      "type": "object",
      "required": ["fixture", "adapter", "code_path"],
      "properties": {
        "fixture": {"type": "string", "minLength": 1},
        "adapter": {"type": "string", "minLength": 1},
        "code_path": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "correctness": {
      "type": "object",
      "required": ["top_level", "semantic_vector"],
      "properties": {
        "top_level": {"$ref": "#/$defs/compatibleStatus"},
        "semantic_vector": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/semanticDisposition"}
        }
      },
      "additionalProperties": false
    },
    "nullableInteger": {"type": ["integer", "null"], "minimum": 0},
    "nullableBoolean": {"type": ["boolean", "null"]},
    "observations": {
      "type": "object",
      "required": [
        "route_installed",
        "route_installation_latency_ns",
        "route_revoked",
        "revocation_latency_ns",
        "maximum_command_age_ns",
        "lineage_complete",
        "owner_matches_expected",
        "observed_owner",
        "successor_installed",
        "successor_installation_latency_ns",
        "fallback_installed",
        "fallback_installation_latency_ns",
        "physical_outcome",
        "observation_completeness",
        "direct_observation_fields"
      ],
      "properties": {
        "route_installed": {"$ref": "#/$defs/nullableBoolean"},
        "route_installation_latency_ns": {"$ref": "#/$defs/nullableInteger"},
        "route_revoked": {"$ref": "#/$defs/nullableBoolean"},
        "revocation_latency_ns": {"$ref": "#/$defs/nullableInteger"},
        "maximum_command_age_ns": {"$ref": "#/$defs/nullableInteger"},
        "lineage_complete": {"$ref": "#/$defs/nullableBoolean"},
        "owner_matches_expected": {"$ref": "#/$defs/nullableBoolean"},
        "observed_owner": {"type": ["string", "null"]},
        "successor_installed": {"$ref": "#/$defs/nullableBoolean"},
        "successor_installation_latency_ns": {"$ref": "#/$defs/nullableInteger"},
        "fallback_installed": {"$ref": "#/$defs/nullableBoolean"},
        "fallback_installation_latency_ns": {"$ref": "#/$defs/nullableInteger"},
        "physical_outcome": {
          "enum": ["LANDED", "DISARMED", "MISSION_COMPLETE", "HOVERING", "OTHER", "UNKNOWN"]
        },
        "observation_completeness": {"type": "number", "minimum": 0, "maximum": 1},
        "direct_observation_fields": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    },
    "arm": {
      "type": "object",
      "required": [
        "arm_id",
        "mechanism",
        "attempt_id",
        "treatment_description",
        "realized_match",
        "evidence_gate",
        "correctness",
        "observations"
      ],
      "properties": {
        "arm_id": {"type": "string", "minLength": 1},
        "mechanism": {
          "enum": ["legacy_offboard", "dynamic_external_mode", "mode_executor"]
        },
        "attempt_id": {"type": "string", "minLength": 1},
        "treatment_description": {"$ref": "#/$defs/treatment"},
        "realized_match": {"$ref": "#/$defs/realizedMatch"},
        "evidence_gate": {"enum": ["ADMISSIBLE", "INADMISSIBLE"]},
        "correctness": {"$ref": "#/$defs/correctness"},
        "observations": {"$ref": "#/$defs/observations"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
