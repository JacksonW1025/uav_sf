{
  "$defs": {
    "digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "route": {
      "enum": [
        "px4_internal",
        "legacy_offboard",
        "dynamic_external_mode",
        "mode_executor",
        "internal_hold",
        "internal_rtl",
        "internal_land",
        "internal_recovery"
      ]
    },
    "safe_route": {
      "enum": [
        "internal_hold",
        "internal_rtl",
        "internal_land",
        "internal_recovery"
      ]
    }
  },
  "$id": "https://jacksonw1025.github.io/uav_sf/experiment_plan.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "else": {
        "not": {
          "required": [
            "workload"
          ]
        }
      },
      "if": {
        "properties": {
          "schema_version": {
            "const": "1.3"
          }
        }
      },
      "then": {
        "required": [
          "workload"
        ]
      }
    }
  ],
  "properties": {
    "cleanup": {
      "additionalProperties": false,
      "properties": {
        "require_disarmed": {
          "type": "boolean"
        },
        "require_landed": {
          "type": "boolean"
        },
        "safe_terminal_routes": {
          "items": {
            "$ref": "#/$defs/safe_route"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "require_landed",
        "require_disarmed",
        "safe_terminal_routes"
      ],
      "type": "object"
    },
    "execution_environment": {
      "additionalProperties": false,
      "properties": {
        "architecture": {
          "minLength": 1,
          "type": "string"
        },
        "collector_host_id": {
          "minLength": 1,
          "type": "string"
        },
        "environment_id": {
          "minLength": 1,
          "type": "string"
        },
        "environment_manifest_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "const": "REPLACE-BEFORE-EXECUTION"
            }
          ]
        },
        "execution_host_id": {
          "minLength": 1,
          "type": "string"
        },
        "operating_system": {
          "minLength": 1,
          "type": "string"
        },
        "px4_binary_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "const": "REPLACE-BEFORE-EXECUTION"
            }
          ]
        },
        "target_kind": {
          "enum": [
            "sitl",
            "hitl",
            "flight_hardware",
            "REPLACE-BEFORE-EXECUTION"
          ]
        }
      },
      "required": [
        "environment_id",
        "execution_host_id",
        "collector_host_id",
        "target_kind",
        "architecture",
        "operating_system",
        "px4_binary_digest",
        "environment_manifest_digest"
      ],
      "type": "object"
    },
    "plan_id": {
      "minLength": 1,
      "type": "string"
    },
    "required_event_kinds": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "run_id": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "enum": [
        "1.2",
        "1.3",
        "1.4"
      ]
    },
    "sequence_obligations": {
      "additionalProperties": false,
      "description": "Obligations for an episode that can carry more than one sequence. The transition carries the obligations that hold when the condition does not; this block carries the ones that replace them when it does. The condition is decided by trace evidence alone.",
      "properties": {
        "condition": {
          "enum": [
            "external_route_reclaimed_after_fault"
          ]
        },
        "when_observed": {
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "completion_expected": {
              "type": "boolean"
            },
            "expected_successor": {
              "$ref": "#/$defs/route"
            },
            "fallback_expected": {
              "type": "boolean"
            },
            "fault_expected": {
              "type": "boolean"
            },
            "target_activation_count": {
              "items": {
                "minimum": 0,
                "type": "integer"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            }
          },
          "type": "object"
        }
      },
      "required": [
        "condition",
        "when_observed"
      ],
      "type": "object"
    },
    "source_identity": {
      "additionalProperties": false,
      "properties": {
        "dependency_lock_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "const": "REPLACE-BEFORE-EXECUTION"
            }
          ]
        },
        "repository_commit": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{40}$",
              "type": "string"
            },
            {
              "const": "REPLACE-BEFORE-EXECUTION"
            }
          ]
        }
      },
      "required": [
        "repository_commit",
        "dependency_lock_digest"
      ],
      "type": "object"
    },
    "strategy": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "enum": [
            "official_sequence",
            "bounded_random_timing",
            "state_aware"
          ]
        },
        "seed": {
          "type": [
            "integer",
            "null"
          ]
        },
        "simulation_seed": {
          "minimum": 1,
          "type": "integer"
        },
        "timing_bounds_ns": {
          "type": "object"
        }
      },
      "required": [
        "name",
        "seed",
        "simulation_seed",
        "timing_bounds_ns"
      ],
      "type": "object"
    },
    "thresholds": {
      "additionalProperties": {
        "exclusiveMinimum": 0,
        "type": "integer"
      },
      "required": [
        "revocation_deadline_ns",
        "installation_deadline_ns",
        "maximum_effect_gap_ns",
        "maximum_command_age_ns",
        "successor_deadline_ns",
        "fallback_deadline_ns"
      ],
      "type": "object"
    },
    "transition": {
      "additionalProperties": false,
      "properties": {
        "activation_rejection_expected": {
          "type": "boolean"
        },
        "completion_expected": {
          "type": "boolean"
        },
        "expected_executor_owner": {
          "minLength": 1,
          "type": "string"
        },
        "expected_fallback": {
          "$ref": "#/$defs/safe_route"
        },
        "expected_lifecycle_owner": {
          "minLength": 1,
          "type": "string"
        },
        "expected_successor": {
          "$ref": "#/$defs/route"
        },
        "fallback_expected": {
          "type": "boolean"
        },
        "fault_expected": {
          "type": "boolean"
        },
        "registration_rejection_expected": {
          "type": "boolean"
        },
        "source_route": {
          "$ref": "#/$defs/route"
        },
        "target_activation_count": {
          "items": {
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "target_activation_expected": {
          "type": "boolean"
        },
        "target_route": {
          "$ref": "#/$defs/route"
        }
      },
      "required": [
        "source_route",
        "target_route",
        "expected_successor",
        "expected_fallback",
        "expected_lifecycle_owner",
        "expected_executor_owner",
        "target_activation_expected",
        "target_activation_count",
        "registration_rejection_expected",
        "activation_rejection_expected",
        "completion_expected",
        "fault_expected",
        "fallback_expected"
      ],
      "type": "object"
    },
    "workload": {
      "additionalProperties": false,
      "properties": {
        "injection_phase": {
          "minLength": 1,
          "type": "string"
        },
        "observer_config_digest": {
          "$ref": "#/$defs/digest"
        },
        "observer_profile": {
          "enum": [
            "baseline",
            "transition"
          ]
        },
        "phases": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "physical_analysis_plan_digest": {
          "$ref": "#/$defs/digest"
        },
        "physical_validity": {
          "additionalProperties": false,
          "properties": {
            "minimum_motion_entry_progress_m": {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            "minimum_nominal_completion_progress_m": {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            "minimum_takeoff_height_m": {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            "takeoff_dwell_s": {
              "minimum": 0,
              "type": "number"
            }
          },
          "required": [
            "minimum_takeoff_height_m",
            "takeoff_dwell_s",
            "minimum_motion_entry_progress_m",
            "minimum_nominal_completion_progress_m"
          ],
          "type": "object"
        },
        "profile_digest": {
          "$ref": "#/$defs/digest"
        },
        "profile_id": {
          "minLength": 1,
          "type": "string"
        },
        "setpoint_semantics": {
          "enum": [
            "position_only",
            "position_plus_velocity"
          ]
        }
      },
      "required": [
        "profile_id",
        "profile_digest",
        "setpoint_semantics",
        "phases",
        "injection_phase",
        "physical_analysis_plan_digest",
        "observer_profile",
        "observer_config_digest",
        "physical_validity"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "plan_id",
    "run_id",
    "strategy",
    "transition",
    "thresholds",
    "required_event_kinds",
    "source_identity",
    "execution_environment",
    "cleanup"
  ],
  "title": "Family A experiment plan",
  "type": "object"
}
