{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jacksonw1025.github.io/uav_sf/threshold_sensitivity.schema.json",
  "title": "Post-hoc threshold sensitivity summary",
  "type": "object",
  "required": [
    "schema_version",
    "analysis_kind",
    "input_trace_count",
    "oracle_instance_count",
    "transition_instance_count",
    "not_applicable_instance_count",
    "trace_with_continuous_observation_count",
    "metric_summaries",
    "interpretation"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "analysis_kind": {"const": "read_only_one_factor_at_a_time_sensitivity"},
    "input_trace_count": {"const": 151},
    "oracle_instance_count": {"type": "integer", "minimum": 1},
    "transition_instance_count": {"type": "integer", "minimum": 1},
    "not_applicable_instance_count": {"type": "integer", "minimum": 0},
    "trace_with_continuous_observation_count": {"type": "integer", "minimum": 1},
    "metric_summaries": {
      "type": "object",
      "minProperties": 6,
      "additionalProperties": {
        "type": "object",
        "required": [
          "applicable_observation_count",
          "calculable_count",
          "missing_or_unknown_count",
          "frozen_threshold_ns",
          "distribution",
          "verdict_stability",
          "frozen_local_crossing_count"
        ]
      }
    },
    "interpretation": {
      "type": "object",
      "required": [
        "changes_frozen_verdict",
        "default_analysis",
        "missing_values_are_interpolated",
        "dynamic_fallback_uses_com_of_loss_t"
      ],
      "properties": {
        "changes_frozen_verdict": {"const": false},
        "default_analysis": {"const": "one_factor_at_a_time"},
        "missing_values_are_interpolated": {"const": false},
        "dynamic_fallback_uses_com_of_loss_t": {"const": false}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
